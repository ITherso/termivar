# Multi-stage Dockerfile for Venom v0.9.0-alpha
# Produces: latest (full), slim (minimal), full (with tools)

# Stage 1: Builder
FROM rust:slim-bookworm AS builder

WORKDIR /build

# Install dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    pkg-config \
    libssl-dev \
    libpq-dev \
    perl \
    && rm -rf /var/lib/apt/lists/*

# Copy source
COPY . .

# Build release
RUN cargo build --release --locked -p venom-cli

# Stage 2: Runtime base
FROM debian:bookworm-slim AS runtime-base

RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Stage 3: Slim image (minimal)
FROM runtime-base AS slim

LABEL maintainer="VENOM Team <team@venom.dev>"
LABEL version="0.9.0-alpha"
LABEL description="VENOM Pentesting Platform - Slim"

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/target/release/venom /usr/local/bin/venom

# Create app directory
RUN mkdir -p /app/data && chmod 777 /app/data

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD venom --version || exit 1

EXPOSE 8080 3000

ENTRYPOINT ["venom"]
CMD ["--help"]

# Stage 4: Full image (with tools)
FROM runtime-base AS full

LABEL maintainer="VENOM Team <team@venom.dev>"
LABEL version="0.9.0-alpha"
LABEL description="VENOM Pentesting Platform - Full"

# Install additional tools
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    vim \
    net-tools \
    dnsutils \
    postgresql-client \
    redis-tools \
    python3 \
    python3-jinja2 \
    python3-requests \
    python3-yaml \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/target/release/venom /usr/local/bin/venom

# Copy documentation
COPY docs /app/docs

# Create app directory
RUN mkdir -p /app/data /app/config && chmod 777 /app/data

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD venom --version || exit 1

EXPOSE 8080 3000

ENV VENOM_DATA_DIR=/app/data
ENV VENOM_CONFIG_DIR=/app/config
ENV RUST_LOG=venom=info

ENTRYPOINT ["venom"]
CMD ["--help"]

# Stage 5: Development image (with dev tools)
FROM full AS dev

# Install development tools
RUN apt-get update && apt-get install -y \
    build-essential \
    gdb \
    strace \
    tcpdump \
    && rm -rf /var/lib/apt/lists/*

ENV RUST_BACKTRACE=1
